{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "django",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["manage.py", "runserver", "8765", "--noreload"],
      "port": 8765
    },
    {
      "name": "olympiad-samples",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8790", "--bind", "127.0.0.1", "--directory", "docs/olympiad/samples"],
      "port": 8790
    }
  ]
}
