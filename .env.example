# Скопируйте в .env и заполните. Файл .env не публикуйте.
DJANGO_DEBUG=0
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_ALLOWED_HOSTS=chem.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://chem.example.ru
DJANGO_TIME_ZONE=Europe/Moscow
# Пока нет HTTPS (только для первой проверки по http://IP) поставьте 0
DJANGO_SECURE_COOKIES=1

# PostgreSQL
POSTGRES_DB=chem
POSTGRES_USER=chem
# пароль из CREATE ROLE; используйте буквы и цифры (файл читает и deploy/backup.sh)
POSTGRES_PASSWORD=замените-на-пароль-базы
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Только для переноса данных со старой базы SQLite (см. README), потом удалите строку
# DJANGO_LEGACY_SQLITE=/srv/chem/app/db.sqlite3
